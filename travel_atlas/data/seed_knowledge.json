      "id": "tokyo-sakura",
      "area_id": "city-tokyo",
      "category_key": "nature",
      "topic_key": "seasonality",
      "value": {
        "title": "Cherry blossom (sakura) season",
        "body": "Tokyo's cherry blossom season is a defining seasonal marker of the city's calendar. JNTO tracks a bloom forecast that moves south to north across Japan each year; Tokyo's average full-bloom date has historically fallen in late March to early April, though exact timing shifts year to year with spring temperatures. Hanami (blossom viewing) gatherings in parks are a widely observed seasonal tradition during this window."
      },
      "source_id": "jnto-cherry-blossoms",
      "confidence": "high",
      "review_status": "reviewed",
      "season_start_month_day": "03-20",
      "season_end_month_day": "04-10",
      "season_label": "Cherry blossom (sakura) season"
    },
    {
      "id": "kz-wild-apple",
      "area_id": "city-almaty",
      "category_key": "nature",
      "topic_key": "ecological_heritage",
      "value": {
        "title": "Native homeland of the wild apple",
        "body": "The foothills of the Tian Shan mountains around Almaty are the documented center of origin of Malus sieversii, the principal wild ancestor of the domesticated apple. USDA-ARS-led germplasm expeditions collected wild apple material here from the late 1980s through the 1990s, and Almaty's own name is popularly linked to the apple. Spring bloom in these wild apple forests is an approximate, regionally variable window, not a precise phenological calendar."
      },
      "source_id": "smithsonian-wild-apple",
      "confidence": "medium",
      "review_status": "reviewed",
      "season_start_month_day": "04-15",
      "season_end_month_day": "05-31",
      "season_label": "Wild apple forest bloom (approximate)"
    },
    {
      "id": "kz-pastoral-calendar",
      "area_id": "country-kz",
      "category_key": "history",
      "topic_key": "seasonal_traditions",
      "value": {
        "title": "Pleiades-based pastoral seasonal calendar",
        "body": "Kazakh and other Central Asian nomadic peoples historically used the appearance and disappearance of the Pleiades star cluster (locally 'Urker'), alongside other seasonal markers, as part of a lunar-stellar calendar that guided the timing of seasonal herd movements (transhumance). This entry describes documented ethnoastronomical tradition and its general seasonal association with late-spring pastoral activity; it is not a calculated heliacal-rising date for any specific year or location."
      },
      "source_id": "researchgate-pleiades-kazakh",
      "confidence": "medium",
      "review_status": "reviewed",
      "season_start_month_day": "05-15",
      "season_end_month_day": "06-15",
      "season_label": "Traditional start of spring pastoral movement"
    },
    {
      "id": "kz-nauryz",
      "area_id": "country-kz",
      "category_key": "history",
      "topic_key": "seasonal_traditions",
      "value": {
        "title": "Nauryz: spring equinox new year",
        "body": "Nauryz, the Central Asian celebration of the spring equinox and new year, is inscribed on UNESCO's Representative List of the Intangible Cultural Heritage of Humanity (2009, extended 2016) and is publicly celebrated across Kazakhstan with rituals tied to renewal and the agricultural and pastoral calendar."
      },
      "source_id": "unesco-nauryz",
